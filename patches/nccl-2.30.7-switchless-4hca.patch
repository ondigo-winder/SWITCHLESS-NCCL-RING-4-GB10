+// Modified by switchless-4hca: IPv4-mapped GID <-> IPv4 address.
+static bool ncclIbGidToIpv4(const union ibv_gid* gid, uint32_t* ip) {
+  for (int i = 0; i < 10; i++)
+    if (gid->raw[i] != 0) return false;
+  if (gid->raw[10] != 0xff || gid->raw[11] != 0xff) return false;
+  memcpy(ip, gid->raw + 12, sizeof(*ip));
+  return *ip != 0;
+}
+
+static void ncclIbIpv4ToGid(uint32_t ip, union ibv_gid* gid) {
+  memset(gid, 0, sizeof(*gid));
+  gid->raw[10] = 0xff;
+  gid->raw[11] = 0xff;
+  memcpy(gid->raw + 12, &ip, sizeof(ip));
+}
